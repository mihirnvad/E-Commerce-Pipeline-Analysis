# Copy to .env and adjust. Every entry point (Scrapy, scripts, analysis) reads these.

# MongoDB (docker compose publishes it on localhost:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=ecommerce

# Mongo pipeline batching: flush every N operations or every N seconds
MONGO_BATCH_SIZE=500
MONGO_FLUSH_INTERVAL=5

# Headless rendering via scrapy-playwright (needs `python -m playwright install chromium`)
ENABLE_PLAYWRIGHT=0

# Replay responses from .scrapy/httpcache while iterating on parsers
HTTPCACHE_ENABLED=0

LOG_LEVEL=INFO

# Tests: MongoDB used by the storage tests (skipped if unreachable)
MONGO_TEST_URI=mongodb://localhost:27017
